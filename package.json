    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
