  "private": true,
  "scripts": {
    "dev": "next dev",
    "backend:dev": "tsx watch backend/server.ts",
    "backend:start": "tsx backend/server.ts",
    "dev:all": "concurrently -k -n web,api -c cyan,green \"next dev\" \"tsx watch backend/server.ts\"",
    "build": "next build",
    "start": "next start",
